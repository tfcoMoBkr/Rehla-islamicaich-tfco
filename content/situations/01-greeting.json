  "art": "greeting",
  "title": {
    "ar": "إلقاء السلام وردّه",
    "en": "Giving and returning the greeting"
  },
  "scene": {
    "ar": "تدخل غرفة الاستراحة في عملك، وفيها مجموعة من زملائك المسلمين جالسون يتحدثون. لم تعتد بعدُ على التحية التي يتبادلونها، وتحب أن تبدأ بها أنت.",
    "en": "You walk into the break room at work, where a group of Muslim colleagues are sitting and talking. You are not used to the greeting they exchange yet, and you would like to be the one who starts it."
  },
  "character": {
    "ar": "يوسف، زميلك في العمل",
    "en": "Yusuf, a colleague"
  },
  "learn": {
    "say": [
      {
        "ref": "h3587",
        "ar": "السَّلَامُ عَلَيْكُمْ",
        "en": "As-salāmu ‘alaykum (peace be upon you)"
      },
      {
        "ref": "h3587",
        "ar": "السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ",
        "en": "As-salāmu ‘alaykum wa rahmatullāh (may the peace and mercy of Allah be upon you)"
      }
    ],
    "why": [
      {
        "ref": "h5808",
        "ar": "تُطْعِمُ الطَّعَامَ، وَتَقْرَأُ السَّلاَمَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ",
        "en": "Feeding people and extending the greeting of peace to those you know and those you do not know"
      },
      {
        "ref": "b-greeting",
        "ar": "ومنها: السلام",
        "en": "Among them are: greeting with peace"
      }
    ],
    "when": [
      {
        "ref": "h5352",
        "ar": "لِيُسَلِّمِ الصغيرُ على الكبيرِ، والمارُّ على القاعدِ",
        "en": "The young should greet the old, the passer-by should greet the one who is sitting"
      },
      {
        "ref": "q4-86",
        "ar": "وَإِذَا حُيِّيتُم بِتَحِيَّةٖ فَحَيُّواْ بِأَحۡسَنَ مِنۡهَآ أَوۡ رُدُّوهَآۗ",
        "en": "And when you are greeted with a greeting, greet [in return] with one better than it or [at least] return it"
      }
    ]
  },
  "exchanges": [
