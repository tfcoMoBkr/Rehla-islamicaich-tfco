    "en": "Getting ready for a long walk"
  },
  "objectives": {
    "ar": [
      "أن تجهّز حقيبة خفيفة",
      "أن تعرف متى تشرب الماء",
      "أن تخبر أحدًا بطريقك قبل أن تنطلق"
    ],
    "en": [
      "Pack a light bag",
      "Know when to drink water",
      "Tell someone your route before you set off"
    ]
  },
  "sources": [],
  "suggestedVideo": {
    "ar": null,
    "en": null
