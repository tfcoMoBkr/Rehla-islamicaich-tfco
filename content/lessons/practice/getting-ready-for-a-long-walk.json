  "cards": [
    {
      "id": "c1",
      "source": [],
      "text": {
        "ar": "ابدأ بحقيبة خفيفة: كل ما تحمله ستشعر بوزنه في آخر النهار.",
        "en": "Start with a light bag: you will feel the weight of everything you carry by the end of the day."
      },
      "check": {
        "type": "trueFalse",
        "prompt": {
          "ar": "الحقيبة الأثقل أفضل لرحلة مشي طويلة.",
          "en": "A heavier bag is better for a long walk."
        },
        "answer": false
      }
    },
    {
      "id": "c2",
      "source": [],
      "text": {
        "ar": "اشرب الماء قبل أن تعطش، على دفعات صغيرة طوال الطريق.",
        "en": "Drink water before you feel thirsty, in small sips along the way."
      },
      "check": {
        "type": "single",
        "prompt": {
          "ar": "متى تشرب الماء في رحلة مشي طويلة؟",
          "en": "When should you drink water on a long walk?"
        },
        "options": [
          {
            "ar": "عندما أعطش كثيرًا فقط",
            "en": "Only when I am very thirsty",
            "correct": false
          },
          {
            "ar": "على دفعات صغيرة طوال الطريق",
            "en": "In small sips along the way",
            "correct": true
          },
          {
            "ar": "في نهاية الطريق فقط",
            "en": "Only at the end",
            "correct": false
          }
        ]
      }
    },
    {
      "id": "c3",
      "source": [],
      "text": {
        "ar": "اختر حذاءً جرّبته من قبل، ولا تبدأ رحلة طويلة بحذاء جديد.",
        "en": "Choose shoes you have worn before; do not start a long walk in new shoes."
      },
      "check": {
        "type": "trueFalse",
        "prompt": {
          "ar": "الرحلة الطويلة فرصة جيدة لتجربة حذاء جديد.",
          "en": "A long walk is a good chance to try out new shoes."
        },
        "answer": false
      }
    },
    {
      "id": "c4",
      "source": [],
      "text": {
        "ar": "أخبر أحدًا تثق به بطريقك وموعد عودتك قبل أن تنطلق.",
        "en": "Before you set off, tell someone you trust your route and when you expect to be back."
      }
    },
    {
      "id": "c5",
      "source": [],
      "text": {
        "ar": "في الحقيبة: ماء، وخريطة، وقبعة للظل، ومصباح لما بعد الغروب، ووجبة خفيفة.",
        "en": "In the bag: water, a map, a hat for shade, a torch for after sunset, and a snack."
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "title": {
        "ar": "تفقّد الطقس",
        "en": "Check the weather"
      },
      "text": {
        "ar": "انظر إلى حالة الطقس قبل أن تحدد موعد الانطلاق.",
        "en": "Look at the weather before you choose when to set off."
      }
    },
    {
      "n": 2,
      "title": {
        "ar": "جهّز الحقيبة",
        "en": "Pack the bag"
      },
      "text": {
        "ar": "ضع فيها ما تحتاجه فقط، ودع الباقي في البيت.",
        "en": "Put in only what you need and leave the rest at home."
      }
    },
    {
      "n": 3,
      "title": {
        "ar": "أخبر أحدًا بطريقك",
        "en": "Tell someone your route"
      },
      "text": {
        "ar": "قل لمن تثق به أين ستمشي ومتى تعود.",
        "en": "Tell someone you trust where you will walk and when you will be back."
      }
    },
    {
      "n": 4,
      "title": {
        "ar": "انطلق في الصباح",
        "en": "Set off in the morning"
      },
      "text": {
        "ar": "امشِ في برودة الصباح، واسترح وقت الظهيرة.",
        "en": "Walk in the cool of the morning and rest at midday."
      }
    }
  ],
