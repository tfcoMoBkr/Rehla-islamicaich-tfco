  "title": {
    "ar": "حين يعطس أحد",
    "en": "When someone sneezes"
  },
  "scene": {
    "ar": "في اجتماع صباحي يعطس زميلك المسلم ويقول شيئًا بصوت منخفض. وبعد قليل تعطس أنت أيضًا.",
    "en": "In a morning meeting, your Muslim colleague sneezes and says something quietly. A little later, you sneeze too."
  },
  "character": {
    "ar": "عمر، زميلك",
    "en": "Omar, a colleague"
  },
  "learn": {
    "say": [
      {
        "ref": "h3433",
        "ar": "فَلْيَقُل: الحَمْدُ للهِ",
        "en": "he should say 'alhamdu-lillāh' (praise be to Allah)"
      },
      {
        "ref": "h3433",
        "ar": "يَرْحَمُكَ الله",
        "en": "'yarhamuk Allah' (may Allah have mercy on you)"
      },
      {
        "ref": "h3433",
        "ar": "يَهْدِيكُم الله ويُصْلِحُ بَالَكُم",
        "en": "'yahdīkum Allah wa yuslih bālakum!' (may Allah guide you and grant you well being)"
      }
    ],
    "why": [
      {
        "ref": "h3706",
        "ar": "وَتَشْمِيتُ الْعَاطِسِ",
        "en": "saying tashmīt (yarhamuk Allah) (may Allah show mercy to you) to the person who sneezes"
      }
    ],
    "when": [
      {
        "ref": "b-sneezing",
        "ar": "وتشميت العاطس إذا حمد الله",
        "en": "responding to the sneezer if they praise Allah"
      }
    ]
  },
